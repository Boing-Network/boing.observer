# Boing Network RPC endpoints (HTTP POST, JSON-RPC 2.0).
# No auth — public read-only RPC.
# Canonical contract: boing.network docs/THREE-CODEBASE-ALIGNMENT.md
# (§2 default RPC; §2.1 = public testnet vs local node — explorer uses NEXT_PUBLIC_TESTNET_RPC, not localhost)

# Testnet — public RPC (trailing slash optional; app normalizes)
NEXT_PUBLIC_TESTNET_RPC=https://testnet-rpc.boing.network/
# Optional extra origins (comma-separated). Hosted Fly backends are already built-in fallbacks.
# NEXT_PUBLIC_TESTNET_RPC_FALLBACKS=https://boing-testnet-1.fly.dev

# --- Public QA voting (`/qa`) ---
# Server-only. Do not prefix with NEXT_PUBLIC_ (would leak to the browser).
# Same value as the validator's BOING_OPERATOR_RPC_TOKEN (X-Boing-Operator).
# Operator-only RPC methods are fail-closed: a node rejects them (-32057) unless it has this token configured and the
# header matches. The explorer never sends this to the browser.
# BOING_OPERATOR_RPC_TOKEN=
# Vote RPC must be the producing validator (in-memory QA pool). Defaults to boing-testnet-1.
# Used for unsigned fallback and sign-then-proxy. Wallet `boing_sendTransaction` uses the user's Express RPC.
# BOING_QA_VOTE_RPC=https://boing-testnet-1.fly.dev

# --- Permission-gated media blob download (`/api/blob/download`) ---
# Primary path (Phase 34): publisher / ACL grantee connects a wallet; the panel signs a download
# proof and the Worker forwards X-Boing-Blob-* headers to Fly GET /v1/media/blob?id=… (not the
# public gateway — that path caps JSON at 6 MiB). ACL metadata is public via GET /api/blob/access.
# Break-glass: paste a token matching BOING_BLOB_DOWNLOAD_TOKENS and/or BOING_OPERATOR_RPC_TOKEN.
# BOING_BLOB_DOWNLOAD_TOKENS=download-token-1,download-token-2
# Optional override (defaults to HOSTED_TESTNET_RPC_FALLBACKS[0] / boing-testnet-1 only; t2 retired):
# BOING_BLOB_DOWNLOAD_RPC=https://boing-testnet-1.fly.dev

# Mainnet — leave UNSET until a distinct mainnet JSON-RPC URL is published.
# Do not point this at testnet; the UI enables mainnet only when this differs from testnet.
# NEXT_PUBLIC_MAINNET_RPC=

# GitHub owner/repo for protocol docs + canonical QA JSON links on /qa (default: Boing-Network/boing.network)
# NEXT_PUBLIC_BOING_PROTOCOL_DOCS_REPO=Boing-Network/boing.network

# Optional: durable reference-NFT owner index Worker (boing.network workers/nft-owner-indexer).
# Enables GET /api/account/nfts?network=testnet&id=0x… beyond the 256-block RPC scan.
# NFT_OWNER_INDEXER_URL=https://boing-nft-owner-indexer.<account>.workers.dev
# (alias: BOING_NFT_OWNER_INDEXER_URL)

# Optional: linked NFT↔fungible token registry AccountId (public testnet CREATE2 default is baked in).
# v2 registry: salt BOING_NFT_TOKEN_LINK_REG_V2; selectors 0xE0-0xE8 (claim_self 0xE7, get_asset_deployer 0xE8).
# v1 (0xebf9f019...3dd8) is superseded. Explorer reads links via links_count / get_link_at.
# NEXT_PUBLIC_BOING_LINKED_NFT_TOKEN_REGISTRY=0xf704485ad29f56bb6516ac822fcf9ca8fcb6c4266e22c9ed7f9c6908668655dd

# Optional: builder attestation registry AccountId (public testnet CREATE2; for future read-only Builder attested UI).
# Salt BOING_BUILDER_ATTEST_REG_V1; selectors 0xE0–0xE6. Companions remain project authority; this is a builder signal.
# Soft wallet-proof JSON is not network authority. Protocol: BOING-BUILDER-ATTESTATION.md on boing.network.
# NEXT_PUBLIC_BOING_BUILDER_ATTESTATION_REGISTRY=0x734077a9f926077d39e84ec278b77b7b600c840f7101809646d8797a6a9e1816

# Optional: Search engine verification (Google Search Console, Bing Webmaster Tools)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-verification-code
# NEXT_PUBLIC_BING_SITE_VERIFICATION=your-bing-verification-code

# --- Server-side tuning (all optional; see docs/OPERATIONS.md) ---
# Token index disk cache. TOKEN_INDEX_CACHE_DIR=off disables it; default <cwd>/.cache/token-index. TTL seconds (default 600).
# TOKEN_INDEX_CACHE_DIR=
# TOKEN_INDEX_CACHE_TTL_SEC=600
# Extra off-chain token metadata gateways, comma-separated templates containing {hash}.
# TOKEN_METADATA_GATEWAY_URLS=https://example.com/meta/{hash}.json
# Return DEX diagnostics from /api/dex/* (plain text var, not a secret).
# BOING_OBSERVER_ALLOW_DEX_DIAGNOSTICS=1
# App-level API rate limiting (default on) and a multiplier for all per-route limits. See docs/OPERATIONS.md.
# BOING_OBSERVER_RATE_LIMIT=on
# BOING_OBSERVER_RATE_LIMIT_SCALE=1
# CSP mode: nonce-enforce (default) | report-only (rollback: allow inline scripts, report only) | nonce-report-only | off
# For the deployed Worker set it in wrangler.toml [vars] (wrangler deploy overwrites dashboard-only variables).
# BOING_OBSERVER_CSP=nonce-enforce
# Override the native DEX factory used for discovery (0x + 64 hex); normally resolved from boing_getNetworkInfo.
# BOING_NATIVE_VM_DEX_FACTORY=0x

# --- Optional protocol-timing fallbacks (newer nodes publish both in boing_getNetworkInfo, which wins over these) ---
# Storage-tree v2 activation height (boing.network BOING_STORAGE_TREE_V2_ACTIVATION_HEIGHT). Leave UNSET until the network
# schedules it; when set, block pages note which storage layout applies and /tools/account-proof explains it.
# NEXT_PUBLIC_BOING_STORAGE_TREE_V2_ACTIVATION_HEIGHT=
# Receipt retention window in blocks (node default 1000000, 0 = nodes keep every receipt). Tunes the "receipt may be pruned" hint on /tx/:id.
# NEXT_PUBLIC_BOING_RECEIPT_RETENTION_BLOCKS=1000000

# --- Playwright only (not read by the app) ---
# OBSERVER_CONTRACTS_LIVE=1   # run live testnet contract specs
# OBSERVER_NAMES_LIVE=1       # run live testnet name specs
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
